# Public demo credentials for this temporary/reference branch.
# Replace all of these when the service moves to the private class repository.
# Team 0 keeps its demo token. Teams 1-5 use the public/hidden
# scenario tokens controlled by data/scenario_access.json.
TEAM_TOKENS_JSON={"team_0":"course-demo-team-0-token"}
SCENARIO_ACCESS_FILE=data/scenario_access.json
# Optional deployment override for scenario token values.
SCENARIO_TOKENS_JSON=
INSTRUCTOR_TOKEN=course-demo-instructor-token
ALLOW_UNAUTHENTICATED_DEV=false

# Default Manager provider shown by the Case 0 UI.
# Supported values: google, openai, anthropic, deepseek
MANAGER_PROVIDER=google

# Optional legacy explicit model override. Leave blank to use the provider-specific values.
MANAGER_MODEL=

# Provider-specific model ids.
GOOGLE_MANAGER_MODEL=google:gemini-2.5-flash
OPENAI_MANAGER_MODEL=openai:gpt-5.6-sol
ANTHROPIC_MANAGER_MODEL=anthropic:claude-sonnet-4-6
DEEPSEEK_MANAGER_MODEL=deepseek:deepseek-v4-flash

# Add credentials only for providers you want to use.
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# Maximum model requests allowed in one Manager run. Pydantic AI defaults to 50;
# this challenge allows a little more room for tool-driven planning while remaining bounded.
MANAGER_REQUEST_LIMIT=75

# Logging / observability
# DEBUG includes simulator week/order detail and every training epoch.
LOG_LEVEL=INFO
# Text layout: LEVEL time [trace_id:...] [span_id:...] file -  body
LOG_FORMAT=text
# Color INFO/WARNING/ERROR prefixes in interactive terminals.
LOG_COLORS=true
LOG_FILE=logs/data-api.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
# Safe/redacted inputs/outputs are included when true.
LOG_PAYLOADS=true
LOG_MAX_VALUE_CHARS=4000
LOG_MAX_COLLECTION_ITEMS=100
