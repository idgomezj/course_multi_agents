# Public demo credentials for this temporary/reference branch.
# Replace all of these when the service moves to the private class repository.
TEAM_TOKENS_JSON={"team_0":"course-demo-team-0-token","team_1":"course-demo-team-1-token","team_2":"course-demo-team-2-token","team_3":"course-demo-team-3-token","team_4":"course-demo-team-4-token","team_5":"course-demo-team-5-token"}
INSTRUCTOR_TOKEN=course-demo-instructor-token
ALLOW_UNAUTHENTICATED_DEV=false

# Default Manager provider shown by the Case 0 UI.
# Supported values: google, openai, anthropic, deepseek
MANAGER_PROVIDER=google

# Optional legacy explicit model override. Leave blank to use the provider-specific values.
MANAGER_MODEL=

# Provider-specific model ids.
GOOGLE_MANAGER_MODEL=google:gemini-2.5-flash
OPENAI_MANAGER_MODEL=openai:gpt-5.6-sol
ANTHROPIC_MANAGER_MODEL=anthropic:claude-sonnet-4-6
DEEPSEEK_MANAGER_MODEL=deepseek:deepseek-v4-flash

# Add credentials only for providers you want to use.
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
