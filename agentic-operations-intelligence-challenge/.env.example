# Main LLM used by Pydantic AI.
MANAGER_MODEL=google:gemini-3.7-flash
GOOGLE_API_KEY=

# Standalone service created on branch service/agentic-operations-data-api.
DATA_API_URL=http://localhost:8100

# Each group receives only its own team token.
DATA_API_TOKEN=

# Instructor-only optional token. Do not give this to students.
DATA_API_INSTRUCTOR_TOKEN=
