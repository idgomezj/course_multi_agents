# Manager LLM provider selected by default in the UI.
# Supported values: google, openai, anthropic, deepseek
MANAGER_PROVIDER=google

# Optional legacy explicit override. Leave blank to use the provider-specific model below.
MANAGER_MODEL=

# Provider-specific model ids. You can replace these with another compatible model.
GOOGLE_MANAGER_MODEL=google:gemini-2.5-flash
OPENAI_MANAGER_MODEL=openai:gpt-5.6-sol
ANTHROPIC_MANAGER_MODEL=anthropic:claude-sonnet-4-6
DEEPSEEK_MANAGER_MODEL=deepseek:deepseek-v4-flash

# Add the API keys for the providers you want students/instructors to use.
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# Hosted course Data API. Override only if intentionally running another Data API deployment.
DATA_API_URL=https://course-agentic-api.idgomezj.com

# Identifies this application to the canonical start-context endpoint.
# This is routing/context metadata, not an authentication mechanism.
DATA_API_CLIENT_TYPE=challenge-runtime

# Active scenario token for this run.
# Use the team's public token during normal development.
# Switch to the team's hidden token only when the instructor releases it.
# Tokens are controlled by the Data API service in data/scenario_access.json.
DATA_API_TOKEN=

# Instructor-only optional token. Do not give this to students.
DATA_API_INSTRUCTOR_TOKEN=

# Maximum model requests allowed in one Manager run. Pydantic AI defaults to 50;
# this challenge allows a little more room for tool-driven planning while remaining bounded.
MANAGER_REQUEST_LIMIT=75

# Logging / observability
# DEBUG shows every model-training epoch and other verbose internals.
LOG_LEVEL=INFO
# Text layout: LEVEL time [trace_id:...] [span_id:...] file -  body
LOG_FORMAT=text
# Color INFO/WARNING/ERROR prefixes in interactive terminals.
LOG_COLORS=true
# Logs are written both to stdout and this rotating file.
LOG_FILE=logs/challenge.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
# When true, safe/redacted tool inputs and outputs are included.
LOG_PAYLOADS=true
LOG_MAX_VALUE_CHARS=4000
LOG_MAX_COLLECTION_ITEMS=100
